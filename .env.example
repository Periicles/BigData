# Copier en .env puis renseigner :  cp .env.example .env
# Le .env n'est JAMAIS versionné (cf. .gitignore).

# ── ClickHouse ──

# Administration : compte du pipeline, seul à pouvoir écrire.
CH_ADMIN_USER=eds_admin
CH_ADMIN_PASSWORD=change-moi

# Restitution : les deux profils métier (cloisonnement RGPD).
CH_PILOTAGE_PASSWORD=change-moi-aussi
CH_RECHERCHE_PASSWORD=change-moi-encore

# Investigation : lecture seule sur les couches techniques.
CH_EXPLOITATION_PASSWORD=change-moi-exploitation

# ── Pseudonymisation ──

# Sel de pseudonymisation.
# Sa divulgation rendrait le hachage des identifiants patients réversible
# par attaque par dictionnaire : l'espace des IPP est énumérable.
# Générer avec :  python3 -c "import secrets; print(secrets.token_hex(32))"
EDS_PSEUDO_SALT=

# ── Seuils d'alerte clinique (facultatif) ──

# À ne pas confondre avec les plages de plausibilité du sujet, qui sont des
# règles de validité de la donnée et vivent en silver. Ici il s'agit de
# qualifier une mesure valide d'« en alerte » : une décision clinique, dont il
# n'existe aucune valeur réglementaire. Les moniteurs sortent d'usine avec des
# valeurs par défaut que chaque service — voire chaque patient — ajuste.
# Décommenter pour surcharger les valeurs par défaut d'eds/config.py (celles
# fixées par l'intervenant : FC < 50 ou > 100, SpO2 < 92, T° > 38,5).
# EDS_SEUIL_FC_BASSE=50
# EDS_SEUIL_FC_HAUTE=100
# EDS_SEUIL_SPO2_BASSE=92
# EDS_SEUIL_TEMP_HAUTE=38.5

# ── Metabase (restitution) ──────────────────────────────────────────────
# Trois comptes applicatifs : l'administrateur qui provisionne, et un
# compte par public. Chacun n'ouvre QUE le tableau de bord de son usage —
# mais c'est la connexion ClickHouse sous-jacente (eds_pilotage /
# eds_recherche) qui prononce le refus, pas Metabase.
MB_ADMIN_EMAIL=admin@eds-chu.local
MB_ADMIN_PASSWORD=
MB_PILOTAGE_EMAIL=pilotage@eds-chu.local
MB_PILOTAGE_PASSWORD=
MB_RECHERCHE_EMAIL=recherche@eds-chu.local
MB_RECHERCHE_PASSWORD=
